{
  "name": "discord-gemini-telegram-job-bot",
  "version": "1.0.0",
  "description": "24/7 Discord hiring job monitor powered by Gemini AI and Telegram",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/public', 'dist/public', { recursive: true })\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@google/genai": "latest",
    "discord.js-selfbot-v13": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/node-telegram-bot-api": "^0.64.6",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
